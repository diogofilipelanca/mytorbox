# --- Your own keys (single-user mode) ---
# Setting these two makes the addon usable at the plain /manifest.json URL, with NO
# credentials in the install link. Strongly preferred for a personal deployment: the
# base64 :config path is readable by anything that logs a URL.
TORBOX_API_KEY=
TMDB_API_KEY=
RPDB_API_KEY=

# --- Public identity ---
# Domain the addon is served from, used to build the manifest logo URL.
BASE_URL=https://mytorbox.example.com
PORT=7000

# --- Reverse proxy ---
# Number of proxies in front of this process. 1 = one reverse proxy (the Caddy service
# in docker-compose.yml). Set 0 only if the app is exposed directly.
# NEVER set this to `true` — that would let any client forge its own IP via
# X-Forwarded-For and walk straight past every rate limit.
# With 1 hop configured, the app MUST NOT be reachable except through the proxy.
TRUST_PROXY_HOPS=1

# --- Storage ---
# Required for Custom Streams and for a cache that survives restarts. Optional:
# leave EMPTY and the addon falls back to an in-process cache.
#
#   Running locally (npm start):  leave this empty.
#   Running via docker compose:   REDIS_URL=redis://redis:6379
#
# The hostname `redis` only resolves inside the compose network. Setting it locally
# makes every request burn three connection retries before giving up.
REDIS_URL=

# --- Admin ---
# Unlocks /stats and POST /api/cache/clear. Unset means both return 503, not open.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Required when TORBOX_API_KEY is set AND the addon is publicly reachable — otherwise
# anyone who finds the URL browses and streams through your TorBox account.
# Install URL becomes: https://your-domain/manifest.json?token=<this value>
# Generate with: openssl rand -hex 32
ADDON_ACCESS_TOKEN=

STATS_ENABLED=1
STATS_FLUSH_SECONDS=60
